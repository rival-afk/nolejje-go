[Unit]
Description=Nolejje API (Go)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/nolejje
ExecStart=/opt/nolejje/nolejje
Environment=GIN_MODE=release
EnvironmentFile=/opt/nolejje/.env
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
